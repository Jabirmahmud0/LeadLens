# Database
# Note: For Vercel Serverless (Next.js), use the POOLED connection string (usually ending in -pooler.tech)
# For `pnpm run db:push` or migrations locally, use the DIRECT connection string to avoid migration locks.
DATABASE_URL=postgres://user:password@localhost:5432/leadlens

# Worker
WORKER_SECRET=super_secret_worker_key

# Auth
SESSION_SECRET=super_secret_session_key

# SMTP Settings (Brevo Default)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_user
SMTP_PASS=your_brevo_pass
SMTP_FROM=hello@leadlens.com


# Observability & Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=...

