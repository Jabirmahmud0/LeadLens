# Database
# Note: For Vercel Serverless (Next.js), use the POOLED connection string (usually ending in -pooler.tech)
# For `pnpm run db:push` or migrations locally, use the DIRECT connection string to avoid migration locks.
DATABASE_URL=postgresql://user:password@host.example/leadlens?sslmode=require

# Worker
WORKER_URL=http://localhost:3001
WORKER_SECRET=replace_with_at_least_32_random_characters
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Auth
SESSION_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_at_least_32_random_characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=owner@example.com

# Stripe subscriptions (use sandbox values locally/Preview and live values in Production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...

# Analysis and AI
# Comma-separated keys are used in round-robin order. GEMINI_API_KEY remains supported for one-key setups.
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
AI_PRIMARY_PROVIDER=gemini
AI_REQUEST_TIMEOUT_MS=20000
PAGESPEED_API_KEY=your_pagespeed_key
CRAWL_MAX_PAGES=8
CRAWL_FETCH_TIMEOUT_MS=10000
CRAWL_MAX_DURATION_MS=60000

# SMTP Settings (Brevo Default)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_user
SMTP_PASS=your_brevo_pass
SMTP_FROM=hello@leadlens.com


# Observability & Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=...
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
