# Database
# Note: For Vercel Serverless (Next.js), use the POOLED connection string (usually ending in -pooler.tech)
# For `pnpm run db:push` or migrations locally, use the DIRECT connection string to avoid migration locks.
DATABASE_URL=postgresql://user:password@host.example/leadlens?sslmode=require

# Worker
WORKER_URL=http://localhost:3001
WORKER_SECRET=replace_with_at_least_32_random_characters
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=30000

# Auth
SESSION_SECRET=replace_with_at_least_32_random_characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONTHLY_ANALYSIS_LIMIT=25
ADMIN_EMAILS=owner@example.com

# Analysis and AI
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
PAGESPEED_API_KEY=your_pagespeed_key
CRAWL_MAX_PAGES=8
CRAWL_FETCH_TIMEOUT_MS=10000
CRAWL_MAX_DURATION_MS=60000

# SMTP Settings (Brevo Default)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_user
SMTP_PASS=your_brevo_pass
SMTP_FROM=hello@leadlens.com


# Observability & Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=...
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
